+            'decision':'VALID' if valid else 'REPAIR_REQUIRED','issues':[] if valid else ['INVALID_DUPLICATE'],
+            'rationale':'' if valid else 'Fictional suspected duplicate; source review requested',
+            'duration_seconds':10}

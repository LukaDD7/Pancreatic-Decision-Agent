+"""Descriptive metrics for independently annotated, identity-aligned gold graphs.
+
+This does not train a confidence model, select a deployment threshold or enable
+AUTO. Synthetic fixtures may exercise metrics, but cannot calibrate deployment.
+"""
+import argparse
+from collections import Counter
+from itertools import combinations
+import json
+from pathlib import Path
+
+
+def rates(tp, predicted, gold):
+    precision = tp/predicted if predicted else None
+    recall = tp/gold if gold else None
+    return {"true_positive": tp, "predicted": predicted, "gold": gold,
+            "precision": precision, "recall": recall,
+            "f1": 2*tp/(predicted+gold) if predicted+gold else None}
+
+
+def key(edge):
+    return edge["stage"], edge["from"], edge["to"]
+
+
+def coref_pairs(mapping):
+    return {frozenset([a, b]) for a, b in combinations(sorted(mapping), 2) if mapping[a] == mapping[b]}
+
+
+def evaluate(graph, gold):
+    if gold.get("annotation_status") != "ADJUDICATED" or not gold.get("complete_within_declared_scope"):
+        raise ValueError("complete adjudicated gold is required; predictions are not gold")
+    if gold.get("origin") not in {"independent_human", "synthetic_fixture"}:
+        raise ValueError("gold origin must be explicit")
+    if not gold.get("scope") or not gold.get("annotator_ids"):
+        raise ValueError("gold scope and annotation provenance required")
+    gold_mentions = set(gold["mention_to_event"])
+    predicted_mentions = {m["id"] for m in graph["mentions"] if m["kind"] == "DecisionMention"}
+    gp, pp = coref_pairs(gold["mention_to_event"]), coref_pairs(graph["membership"])
+    positives = {"reaffirm", "revise", "supersede", "informs", "implemented_by", "evaluated_by", "triggers_reassessment"}
+    truth = {key(e): e["relation"] for e in gold["relations"]}
+    if len(truth) != len(gold["relations"]):
+        raise ValueError("duplicate gold pair")
+    predictions = {key(e): e for e in graph["edges"]}
+    matched_keys = set(truth) & set(predictions)
+    confusion = Counter((truth[k], predictions[k]["relation"] if k in predictions else "NOT_PROPOSED") for k in truth)
+    per_class = {}
+    for label in sorted(set(truth.values()) - {"uncertain"}):
+        tp = sum(truth[k] == label and predictions[k]["relation"] == label for k in matched_keys)
+        pred_count = sum(e["relation"] == label for k, e in predictions.items() if k in truth)
+        per_class[label] = rates(tp, pred_count, sum(v == label for v in truth.values()))
+    g_edges = {k for k, v in truth.items() if v in positives}
+    p_edges = {k for k, v in predictions.items() if v["relation"] in positives and k in truth}
+    correct = {k for k in p_edges & g_edges if predictions[k]["relation"] == truth[k]}
+    curve = []
+    for threshold in [0, 0.25, 0.5, 0.75, 1.0]:
+        selected = [k for k in matched_keys if predictions[k]["relation"] not in {"uncertain", "different_event"}
+                    and predictions[k]["score"] >= threshold]
+        curve.append({"threshold": threshold, "selected": len(selected),
+                      "coverage_of_annotated_pairs": len(selected)/len(truth) if truth else None,
+                      "precision": sum(predictions[k]["relation"] == truth[k] for k in selected)/len(selected) if selected else None})
+    return {"decision_mention_identity_recall": rates(len(predicted_mentions & gold_mentions), len(predicted_mentions), len(gold_mentions)),
+        "coreference_pairwise": rates(len(gp & pp), len(pp), len(gp)),
+        "typed_relation_edges": rates(len(correct), len(p_edges), len(g_edges)),
+        "candidate_edge_recall": len(g_edges & set(predictions))/len(g_edges) if g_edges else None,
+        "relation_macro_f1": sum(v["f1"] or 0 for v in per_class.values())/len(per_class) if per_class else None,
+        "per_class": per_class, "confusion": [{"gold": a, "predicted": b, "count": n} for (a, b), n in sorted(confusion.items())],
+        "scope_graph_complete": gold_mentions <= predicted_mentions and g_edges <= correct,
+        "unannotated_prediction_pairs": len(set(predictions)-set(truth)),
+        "coverage_precision_curve": curve,
+        "review_rate": sum(e["status"] == "REVIEW" for e in graph["edges"])/len(graph["edges"]) if graph["edges"] else None,
+        "auto_accept_enabled": False, "gold_origin": gold["origin"],
+        "limitation": "identity alignment required; descriptive unweighted metrics within declared scope; no population estimate or deployment calibration"}
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__)
+    p.add_argument("--graph", type=Path, required=True)
+    p.add_argument("--gold", type=Path, required=True)
+    p.add_argument("--output", type=Path, required=True)
+    args = p.parse_args()
+    result = evaluate(json.loads(args.graph.read_text()), json.loads(args.gold.read_text()))
+    with args.output.open("x") as f:
+        json.dump(result, f, ensure_ascii=False, indent=2)
+
+
+if __name__ == "__main__":
+    main()

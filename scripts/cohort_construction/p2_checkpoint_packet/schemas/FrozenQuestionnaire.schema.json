{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:checkpoint-packet:0.1.0:FrozenQuestionnaire",
  "title": "FrozenQuestionnaire",
  "$ref": "#/$defs/questionnaire",
  "$defs": {
    "target": {
      "type": "object",
      "properties": {
        "checkpoint_id": {
          "type": "string",
          "minLength": 1
        },
        "decision_task_id": {
          "type": "string",
          "minLength": 1
        },
        "visibility_policy_version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "checkpoint_id",
        "decision_task_id",
        "visibility_policy_version"
      ],
      "additionalProperties": false
    },
    "sourceBinding": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_id",
        "source_version",
        "sha256"
      ],
      "additionalProperties": false
    },
    "questionnaireResource": {
      "type": "object",
      "properties": {
        "resourceType": {
          "const": "Questionnaire"
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "const": "active"
        }
      },
      "required": [
        "resourceType",
        "url",
        "version",
        "status"
      ],
      "additionalProperties": true
    },
    "questionnaire": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "frozen": {
          "const": true
        },
        "resource": {
          "$ref": "#/$defs/questionnaireResource"
        }
      },
      "required": [
        "canonical",
        "version",
        "sha256",
        "frozen",
        "resource"
      ],
      "additionalProperties": false
    },
    "material": {
      "type": "object",
      "properties": {
        "material_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "material_id",
        "source_id",
        "source_version",
        "text",
        "sha256"
      ],
      "additionalProperties": false
    },
    "packetBinding": {
      "type": "object",
      "properties": {
        "packet_id": {
          "type": "string",
          "minLength": 1
        },
        "packet_version": {
          "type": "string",
          "minLength": 1
        },
        "packet_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "clinical_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      },
      "required": [
        "packet_id",
        "packet_version",
        "packet_sha256",
        "clinical_content_sha256",
        "target"
      ],
      "additionalProperties": false
    },
    "questionnaireBinding": {
      "type": "object",
      "properties": {
        "canonical": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "canonical",
        "version",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
